      def count_bytes: () -> Integer
      def hash_size: () -> Integer
      def validate_hash!: (String) -> String
      def validate_slot!: (Slot) -> void
      def nibble: (String, Integer) -> Integer
      def root_pointer: () -> Integer?
      def read: (Integer, Integer) -> String
      def parse_slot: (String) -> Slot
      def read_record: (Slot) -> [ String, Slot, Slot ]
      def entry: (String) -> [ Slot, Slot ]?
      def writable!: () -> void
      def mutate: () { (Transaction) -> top } -> void
      def writable_root: (Transaction) -> Integer
      def publish: (Integer, ?propagate: bool) -> Cursor
      def adjust_count: (Transaction, Integer, Integer) -> void
      def write_entry: (String, key: Slot?, value: Slot?, ?owner: Cursor?, ?collection: bool, ?propagate: bool) -> void
      def collapse_path: (Transaction, Integer, Array[[ Integer, String, Integer ]]) -> void
      def collection_tag: (bool, bool) -> Symbol
      def collapsible?: (Integer, Integer, Array[Slot]) -> bool
      def write_leaf: (Transaction, Integer, Slot, String, Integer, Integer, Slot?, Slot?) -> Integer?
    end

