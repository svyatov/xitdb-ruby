          def initialize: (Integer, Array[Slot], Array[Integer], Array[Slot]) -> void
          def size: () -> Integer
        end
        def record: (Slot) -> [ Slot, Slot ]
        def find: (String) -> Slot?
        def locate: (String) -> [ sorted_path, Node, Integer, bool, Integer ]
        def store: (String, ?value: Slot?, ?key_only: bool, ?owner: Cursor?, ?collection: bool, ?propagate: bool) -> self
        def store_leaf: (Transaction, String, Node, Integer, bool, bool, Slot?) -> void
        def write_path: (Transaction, sorted_path, Node, Integer?) -> Integer
        def collapse_sorted_root: (Transaction, Node, Integer?, Integer) -> Integer
        def remove: (String) -> bool
        def lower_bound: (Integer) { (Integer) -> bool } -> Integer
        def split_separator: (Array[[ Integer, Integer, Slot? ]]) -> Slot
        def key_bytes: (Slot) -> String
