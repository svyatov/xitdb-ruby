    module Replication
      @store: store

      @lock_timeout: Float

      @needs_reopen: bool

      def with_operation: [A] () { () -> A } -> A

      def committed_state: () -> [ Integer, Slot ]

      def header: () -> Header

      CHUNK_SIZE: Integer

      def replica_state: () -> ReplicaState

      def replication_start: (ReplicaState) -> Integer

      def read_committed: (Integer, Integer, _Writer) -> nil

      def apply_replicated: (Integer, _Reader, Integer) -> nil

      def append_replica_chunks: (_Reader, Integer, Integer) -> void

      def recover_replica_application: (Integer, bool, :not_committed | :committed | :unknown) -> void

      def self.validate_replica!: (store, Integer) -> void

      def self.cleanup_staged_replica: (FileStore, bool, :not_committed | :committed | :unknown) -> void

      def self.copy_replica: (to: String, source_io: _Reader, length: Integer) -> Database

      def self.ensure_position!: (Integer) -> void

      def self.trailer: (store, Header, Integer, Integer) -> [ Slot, Integer ]

      def self.read_chunks: (_Reader, Integer) { (String) -> top } -> void

      def self.write_all: (_Writer, String) -> void

      def self.storage_write: [A] (?outcome: :not_committed | :committed | :unknown) { () -> A } -> A
    end
  end
end
