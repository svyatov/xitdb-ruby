    class BTree
      HEADER_SIZE: Integer
      CAPACITY: Integer
      SPLIT_COUNT: Integer
      LEAF_SIZE: Integer
      BRANCH_SIZE: Integer
      type node = Node | SortedMap::Tree::Node
      type path = Array[[ Integer, node, Integer ]]
      type ref = [ Integer?, Integer, Integer? ]
      class Node
        attr_accessor kind: Integer
        attr_accessor slots: Array[Slot]
        attr_accessor counts: Array[Integer]
        def self.new: (Integer, Array[Slot], Array[Integer]) -> Node
        def initialize: (Integer, Array[Slot], Array[Integer]) -> void
        def size: () -> Integer
      end
      @tag: tag
      attr_reader cursor: Cursor
      def initialize: (Cursor, ?tag: tag) -> void
      def size: () -> Integer
      def at: (Integer) -> Slot?
      def insert: (Integer, Slot) -> self
      def replace: (Integer, Slot, ?owner: Cursor?, ?collection: bool, ?propagate: bool) -> self
      def delete_at: (Integer) -> Slot?
      def split: (Integer) -> Array[BTree]
      def slice: (Integer, Integer) -> BTree
      def concat: (BTree) -> BTree
      def each_from_index: (Integer) -> Enumerator[Slot, self]
                         | (Integer) { (Slot) -> top } -> self
      def ensure_integer_index!: (Integer) -> void
      def next_frame: (path) -> [ Integer, node, Integer ]?
      def rebalance_child: (Transaction, node, node, Integer, Integer?) -> void
      def merge_neighbor: (node, node, Integer) -> [ node, Integer ]
      def collapse_root: (Transaction, node, Integer?, Integer) -> Integer
      def resolve_index: (Integer, Integer) -> Integer?
      def read: (Integer, Integer, ?bound: Integer) -> String
      def header: () -> [ Integer, Integer? ]
      def read_node: (Integer, Integer, ?bound: Integer) -> node
      def read_node_header: (Integer, Integer) -> [ Integer, Integer ]
      def node_slots: (String, Integer, Integer) -> Array[Slot]
      def validate_node!: (Node, Integer) -> void
      def validate_branch!: (Node) -> void
      def validate_leaf!: (Node) -> void
      def descend: (Integer?, Integer, Integer, ?insertion: bool, ?ancestors: Array[Integer]) -> [ path, node, Integer ]
      def pointer_for: (path, Integer?) -> Integer?
      def validate_slot!: (Slot) -> void
      def mutate: [A] () { (Transaction) -> A } -> A
      def node_for: (ref) -> node
      def child_ref: (ref, node, Integer) -> ref
      def merge_nodes: (node, node) -> node
      def assemble: (Transaction, node) -> Array[ref]
      def branch: (Array[ref]) -> node
      def height: (ref) -> Integer
      def join_roots: (Transaction, ref, ref) -> ref
      def sibling_root: (Transaction, ref, node, Range[Integer]) -> ref
      def split_root: (Transaction, ref, Integer) -> [ ref, ref ]
      def detached: (Transaction, ref) -> BTree
      def write_node: (Transaction, node, ?Integer?) -> Integer
      def write_split: (Transaction, node, Integer?) -> Array[[ Integer, Integer ]]
      def publish: (Transaction, Integer, Integer, ?propagate: bool) -> Cursor
    end

    class SortedMap
      include Enumerable[[ String, Slot ]]
