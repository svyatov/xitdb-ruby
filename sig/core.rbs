                         | (Integer) { ([ String, Slot ]) -> top } -> self
      def cursor_at: (String, ?create: bool) -> Cursor?
      def replace_child: (String, Slot, ?owner: Cursor?, ?collection: bool, ?propagate: bool) -> self
      def decode: (Slot) -> [ String, Slot ]
