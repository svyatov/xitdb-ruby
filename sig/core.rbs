      HEADER_SIZE: Integer
      BLOCK_SIZE: Integer
      EMPTY_BLOCK: String
      attr_reader cursor: Cursor
      def initialize: (Cursor, ?fields: Array[Slot]) -> void
      def validate_initial_fields!: (Array[Slot]) -> void
      def size: () -> Integer
      def get: (Integer) -> Slot?
      def cursor_at: (Integer, ?create: bool) -> Cursor?
      def append: (Slot) -> self
      def put: (Integer, Slot) -> self
      def replace_child: (Integer, Slot, ?owner: Cursor?, ?collection: bool, ?propagate: bool) -> self
      def truncate: (Integer) -> self
      def each: () -> Enumerator[Slot, self]
              | () { (Slot) -> top } -> self
      def header: () -> [ Integer, Integer? ]
      def branches: (String, Integer, Integer, Integer) -> Array[[ Integer?, Integer, Integer ]]
      def depth: (Integer) -> Integer
      def resolve_index: (Integer, Integer) -> Integer?
      def read: (Integer, Integer) -> String
      def parse_slot: (String) -> Slot
      def read_slot: (Integer) -> Slot
      def read_element: (Integer, Integer, Integer) -> Slot
      def validate_slot!: (Slot) -> void
      def mutate: () { (Transaction) -> top } -> void
      def writable_header: (Transaction) -> [ Integer, Integer, Integer ]
      def copy_block: (Transaction, Integer) -> Integer
      def writable_element: (Transaction, Integer, Integer, Integer) -> Integer
    end

